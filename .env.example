# PayPal REST app from developer.paypal.com → Apps & Credentials (Sandbox).
# Leave both empty to run in demo mode (no PayPal account needed).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Optional: the webhook ID from your PayPal app, to receive "invoice paid" events at /webhooks/paypal
PAYPAL_WEBHOOK_ID=
# Optional: your business name on invoices
BUSINESS_NAME=

# The built-in chat on the dashboard (Anthropic API). MCP works without it.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# Public address (for pay links and the MCP URL shown on the dashboard)
PUBLIC_URL=http://localhost:3000
PORT=3000
# Optional: lock the dashboard, chat and /mcp behind a key (Bearer token or ?key=)
ACCESS_KEY=
